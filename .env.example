# ==============================================================================
# PetroLead — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# --- Application ---
APP_NAME=PetroLead
# Anything other than "development" makes SECRET_KEY mandatory: the app
# refuses to start on the shared dev key. See docs/DEPLOY.md.
APP_ENV=development          # development | production | test
DEBUG=true
API_V1_PREFIX=/api

# --- Database ---
# Production/staging target is PostgreSQL. For zero-config local development
# or running the test suite, leave unset (or point at sqlite) and the app
# will fall back to a local SQLite file automatically.
# Example Postgres URL:
#   DATABASE_URL=postgresql+psycopg://petrolead:petrolead@localhost:5432/petrolead
DATABASE_URL=postgresql+psycopg://petrolead:petrolead@localhost:5432/petrolead

# --- CORS ---
# Comma-separated list of allowed frontend origins. In production this must
# list every origin the site is served from, or the browser blocks every API
# call with no useful error, e.g.:
#   CORS_ORIGINS=https://petrolead.org,https://www.petrolead.org
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Search Providers (Phase 1 discovery) ---
# PetroLead abstracts search behind a SearchProvider interface. Configure
# ONE (or more) of the following. If none are configured, the discovery
# engine runs in MOCK mode and clearly labels all returned data as mock.
#
# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# Bing Web Search API (Azure Cognitive Services)
BING_SEARCH_API_KEY=

# SerpApi (https://serpapi.com/)
SERPAPI_API_KEY=

# SearchAPI.io (https://www.searchapi.io/) — free tier, no credit card
# required at signup
SEARCHAPI_IO_API_KEY=

# Serper.dev (https://serper.dev/) — Google results, 2,500 free queries with
# no credit card, then prepaid credit packs (the cheapest per query here)
SERPER_API_KEY=

# Which provider to use: google_cse | bing | serpapi | searchapi_io | serper | mock
SEARCH_PROVIDER=mock

# --- Email verification ---
# Which service confirms that a mailbox actually exists.
#
# "mx" (the default) has none: it checks DNS only. That proves the DOMAIN
# accepts mail, not that the address does — so a well-formed address at a
# live domain is graded "risky", never "deliverable". This is deliberate:
# the point of verification is to remove addresses that bounce, and a
# domain-only check cannot tell a real mailbox from a typo'd one.
#
# Set a provider and its key to get mailbox-level verdicts. No provider
# reaches 100%: a mailbox can fill up or close after it was checked.
#
# Supported: mx (none) | millionverifier
# A provider name with no adapter is refused at startup rather than
# silently falling back, and a provider named without a key is ignored.
EMAIL_VERIFY_PROVIDER=mx
EMAIL_VERIFY_API_KEY=

# --- Contact-data enrichment (optional) ---
# Hunter.io (https://hunter.io/) — best-effort business-email lookup for a
# specific named person at a known company domain. Only used to enrich the
# "paste a LinkedIn profile link" preview; everything else works without it.
HUNTER_IO_API_KEY=

# --- HTTP / Extraction ---
HTTP_TIMEOUT_SECONDS=10
HTTP_USER_AGENT=PetroLeadBot/1.0 (+https://petrolead.org/bot)
MAX_CONCURRENT_FETCHES=5

# --- Background jobs (future: Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
# Requests per minute per client address, counted per process — with two
# web workers the effective limit is double these numbers. The auth
# allowance is separate and much smaller: that's where password guessing
# happens.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
# Turn on ONLY when a proxy you control sets X-Forwarded-For (any managed
# platform does). If it's on without such a proxy, callers can forge the
# header and give themselves a fresh allowance on every request.
TRUST_PROXY_HEADERS=false

# --- API documentation ---
# /docs, /redoc and /openapi.json map every endpoint and schema. Left unset
# they're served in development only; uncomment to force it either way.
# DOCS_ENABLED=false

# --- Authentication ---
# Signs login session tokens (JWT). The default below is INSECURE and only
# for zero-config local development — generate a real one for anything
# else, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated email addresses that get admin access (view every
# account at GET /admin/users, block/unblock via PATCH /admin/users/{id}).
# Empty by default: nobody is an admin until you set this. Applied on
# every register/login for a matching email — only grants, never revokes.
#
# Admin rights go to whoever REGISTERS one of these addresses: the app
# can't tell the owner of an address from someone who merely typed it. So
# sign up with each one as soon as you set it — until you do, the account
# is there for the taking. The app logs a warning at every startup naming
# any address here that has no account yet.
#   ADMIN_EMAILS=admin@petrolead.org
ADMIN_EMAILS=

# --- Plans & credits ---
# true: every non-admin account needs a plan (bought with crypto, or
# assigned by an admin on the Users page), spends one email credit per
# business email found — a person lookup that returns one, or a company
# search result that comes with one — and is held to its plan's limits.
# Admins are never limited. Set to false to switch all limits off.
BILLING_ENFORCED=true

# --- Crypto payments ---
# Your PUBLIC receiving addresses. Customers see them at checkout, send the
# payment, and click "I have paid"; an admin checks the transaction on a block
# explorer and confirms it. A coin is only offered once its address is set.
# NEVER put a private key or seed phrase here or anywhere in this app.
CRYPTO_BTC_ADDRESS=
# A TRON address (starts with T). Customers must send USDT on the TRON network.
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_TRX_ADDRESS=
# How long a BTC/TRX price quote holds before an unpaid order expires.
CRYPTO_QUOTE_MINUTES=60
# Optional: a free CoinGecko Demo API key for steadier live BTC/TRX prices.
COINGECKO_API_KEY=

# --- Email (optional) ---
# When set, admins get an email for every payment waiting for confirmation.
# Without it, the Payments badge in the app is the only notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Where the web app is served, for links in those emails.
# Production: APP_BASE_URL=https://petrolead.org
APP_BASE_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
