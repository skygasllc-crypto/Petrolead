# ==============================================================================
# PetroLead — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# --- Application ---
APP_NAME=PetroLead
APP_ENV=development          # development | production | test
DEBUG=true
API_V1_PREFIX=/api

# --- Database ---
# Production/staging target is PostgreSQL. For zero-config local development
# or running the test suite, leave unset (or point at sqlite) and the app
# will fall back to a local SQLite file automatically.
# Example Postgres URL:
#   DATABASE_URL=postgresql+psycopg://petrolead:petrolead@localhost:5432/petrolead
DATABASE_URL=postgresql+psycopg://petrolead:petrolead@localhost:5432/petrolead

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Search Providers (Phase 1 discovery) ---
# PetroLead abstracts search behind a SearchProvider interface. Configure
# ONE (or more) of the following. If none are configured, the discovery
# engine runs in MOCK mode and clearly labels all returned data as mock.
#
# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# Bing Web Search API (Azure Cognitive Services)
BING_SEARCH_API_KEY=

# SerpApi (https://serpapi.com/)
SERPAPI_API_KEY=

# SearchAPI.io (https://www.searchapi.io/) — free tier, no credit card
# required at signup
SEARCHAPI_IO_API_KEY=

# Which provider to use: google_cse | bing | serpapi | searchapi_io | mock
SEARCH_PROVIDER=mock

# --- Contact-data enrichment (optional) ---
# Hunter.io (https://hunter.io/) — best-effort business-email lookup for a
# specific named person at a known company domain. Only used to enrich the
# "paste a LinkedIn profile link" preview; everything else works without it.
HUNTER_IO_API_KEY=

# --- HTTP / Extraction ---
HTTP_TIMEOUT_SECONDS=10
HTTP_USER_AGENT=PetroLeadBot/1.0 (+https://example.com/bot)
MAX_CONCURRENT_FETCHES=5

# --- Background jobs (future: Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Authentication ---
# Signs login session tokens (JWT). The default below is INSECURE and only
# for zero-config local development — generate a real one for anything
# else, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated email addresses that get admin access (view every
# account at GET /admin/users, block/unblock via PATCH /admin/users/{id}).
# Empty by default: nobody is an admin until you set this. Applied on
# every register/login for a matching email — only grants, never revokes.
ADMIN_EMAILS=

# --- Logging ---
LOG_LEVEL=INFO
